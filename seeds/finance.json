  "task": {
    "objective": "维护供内部培训使用的产品资料和测算准备记录，在份额、币种、日期及字段口径明确后更新准备状态与补数清单。",
    "instructions": "生成合成产品、份额及观测记录；不将公开文件替代内部持仓、净值、同步价格或客户成本数据。交易币种、估值币种、派息币种分别记录，累积份额和派息份额分开。数据日期不是文件发布日期；同文件不同字段可有不同截止日。有效久期不自动等于修正久期。已披露零值不等于缺失，缺费用不能填零；没有匹配输入时记录待补或口径不匹配，不能承诺计算已完成。本种子只增强输入到白皮书的字段、关系与事件合同，不新增收益、久期或折溢价计算执行器；不生成交易建议、收益承诺或真实客户结论。"
  },
  "exemplars": [
    {
      "title": "岚桥产品的份额档案",
      "content": "以下产品和份额均为合成。岚桥短债产品的岚桥港币派息份额：所属产品=岚桥短债；交易币种=HKD；估值币种=USD；派息币种=HKD；分派方式=派息。另一份额岚桥美元累积份额：所属产品=岚桥短债；交易币种=USD；估值币种=USD；派息币种=不适用；分派方式=累积。",
      "doc_type": "份额资料卡",
      "date": "2025-01-06",
      "origin": "synthetic",
      "source_refs": [],
      "mechanism_refs": [
        "scope_binding"
      ]
    },
    {
      "title": "零值披露与不同口径",
      "content": "本条为合成资料。《岚桥月末久期观测》：观测份额=岚桥港币派息份额；数据日期=2025-01-03；指标口径=有效久期；有效久期=0.00 年；输入状态=已披露。这不是修正久期已披露的证明。《岚桥测算准备单》的测算份额为岚桥港币派息份额，参考观测为《岚桥月末久期观测》，口径核对状态=指标口径不匹配；测算准备状态=需补修正久期。",
      "doc_type": "输入复核单",
      "date": "2025-01-13",
      "origin": "synthetic",
      "source_refs": [],
      "mechanism_refs": [
        "scope_binding",
        "missing_input_gate"
      ]
    },
    {
      "title": "日期与费用核验",
      "content": "本条为合成复核记录。《岚桥测算准备单》的价格日期与净值日期尚未对齐，口径核对状态=样本日期不一致；费用输入状态=未提供；测算准备状态=待补同日数据及费用。费用未提供不能解释为零费用，此条没有给出敏感度或收益率计算结果。",
      "doc_type": "补数清单",
      "date": "2025-01-20",
      "origin": "synthetic",
      "source_refs": [],
      "mechanism_refs": [
        "missing_input_gate"
      ]
    }
  ],
  "mechanisms": [
    {
      "id": "scope_binding",
      "description": "值必须绑定产品、份额、指标口径、币种和数据日期；相邻表格、另一份额或另一截止日的值不能直接补位。资料发布与输入复核形成独立事件，复核状态显式进入世界。",
      "source_refs": [
        {
          "source_id": "finance_hang_seng",
          "locator": "PDF 第1、3–4页：交易/基本/派息货币与市场价格、净值的区别"
        },
        {
          "source_id": "finance_global_x",
          "locator": "PDF 第1、4页：交易柜台币种和分派币种"
        },
        {
          "source_id": "finance_bosera",
          "locator": "PDF 第1页：上市累积股份类别"
        },
        {
          "source_id": "finance_china_amc",
          "locator": "PDF 第3页：财务净值、人员及其他内容采用不同截止日期"
        },
        {
          "source_id": "finance_efund",
          "locator": "PDF 第3–4页：A/C与人民币/美元份额代码、财务表单位"
        }
      ],
      "required_entity_types": [
        "product",
        "share_class",
        "metric_observation",
        "worksheet_record"
