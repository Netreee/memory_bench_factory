  "task": {
    "objective": "根据逐步到达的风险线索和补充材料维护商户复核工单，记录证据充分性、负责团队、允许动作与复查结论。",
    "instructions": "生成新商户和合成材料；地址不一致、门头异常、转单投诉只是待核验线索。证据未提供不等于违法已成立，也不等于问题不存在。区分证照有效但公示未更新、实际场所未覆盖等不同情形。工单应关联商户，补充材料应关联工单；新增材料后再复核结论与处置阶段。平台运营动作与监管处罚分开；不捏造真实处罚编号、真实坐标或已经完成的真实整改。附件5的裁切正文不得使用，附件4和5的同案叙述不得算作两个独立原始证据。"
  },
  "exemplars": [
    {
      "title": "青禾食坊的初次工单",
      "content": "以下商户与工作记录为合成。商户青禾食坊出现线上地址与骑手取餐地址不一致的反馈。工单《青禾地址核验》：关联商户=青禾食坊；证据充分性=待补证；处置阶段=资料核验；责任团队=商户运营。复查结论=尚不能确认具体原因。",
      "doc_type": "风险工单",
      "date": "2025-01-06",
      "origin": "synthetic",
      "source_refs": [],
      "mechanism_refs": [
        "evidence_sufficiency",
        "scoped_action"
      ]
    },
    {
      "title": "补充材料到达",
      "content": "本条为合成补证记录。《青禾新址材料》：关联工单=《青禾地址核验》；材料种类=新址证照与现场照片；材料完整性=已收齐待核验；信息来源=商户提交。材料收到尚不表示平台已经核验通过。",
      "doc_type": "补证登记",
      "date": "2025-01-13",
      "origin": "synthetic",
      "source_refs": [],
      "mechanism_refs": [
        "evidence_sufficiency"
      ]
    },
    {
      "title": "复核后的动作调整",
      "content": "本条为合成复核结果。《青禾地址核验》已核对新址材料，证据充分性=本次地址问题证据充分；复查结论=新址证照有效而平台公示未更新；处置阶段=待更新公示；责任团队=商户运营。待确认公示完成后再关闭该问题；未作监管处罚决定。",
      "doc_type": "复核记录",
      "date": "2025-01-20",
      "origin": "synthetic",
      "source_refs": [],
      "mechanism_refs": [
        "evidence_sufficiency",
        "scoped_action"
      ]
    }
  ],
  "mechanisms": [
    {
      "id": "evidence_sufficiency",
      "description": "从线索到已核验结论需要材料到达与复核两步；知识状态作为明确的业务字段，不将待补证状态映射为无此项。不同异常原因可以得到不同结论。",
      "source_refs": [
        {
          "source_id": "legal_task",
          "locator": "RTF 正文：只能据已知材料生成待核实工单，禁止捏造商户事实及整改完成状态"
        },
        {
          "source_id": "legal_cases",
          "locator": "PDF 第1–2页：搬迁已办新证但平台未更新、冒用资质等不同案例"
        }
      ],
      "required_entity_types": [
        "merchant",
        "review_ticket",
        "evidence_record"
      ],
      "required_relation_types": [
        "ticket_for_merchant",
        "evidence_for_ticket"
      ],
      "required_event_types": [
        "risk_registered",
        "evidence_received",
        "review_updated"
      ],
      "required_causal_rules": [
        "evidence_to_review"
      ]
    },
    {
      "id": "scoped_action",
      "description": "运营责任和允许动作随已核验结论更新，工单保留恢复/关闭前仍需满足的条件。新闻中的调查过程仅启发证据关系，不能替代真实商户台账或证明合成商户受罚。",
      "source_refs": [
        {
          "source_id": "legal_task",
          "locator": "RTF 正文：动作、责任团队、复查条件与待核实字段要求"
        },
        {
          "source_id": "legal_investigation",
          "locator": "PDF 第1–6页：投诉、订单流转、账号关联及交叉核验过程；非原始调查数据库"
        }
      ],
      "required_entity_types": [
        "merchant",
        "review_ticket"
      ],
      "required_relation_types": [
        "ticket_for_merchant"
      ],
      "required_event_types": [
        "review_updated",
        "action_updated"
      ],
      "required_causal_rules": [
        "review_to_action"
      ]
    }
  ],
