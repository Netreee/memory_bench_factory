# Copy to configs/env/secrets.env. The real file is gitignored.
# One file holds provider credentials/endpoints. Model IDs live in each experiment TOML.
# A target's endpoint_profile=NAME reads NAME_API_KEY and NAME_BASE_URL.
# Do not quote values unless the quote is part of the value.

# --- Anthropic (Claude Code) ---
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
CLAUDE_BIN=
# 不设轮数上限：--max-turns 实测不可靠（同一数值下 30~173 轮都可能完成，也可能在
# 31 轮报 error_max_turns），且 codex/dsh 没有对应开关。硬边界统一用 NATIVE_TIMEOUT_S。
CLAUDE_MAX_BUDGET_USD=5.00

# --- OpenAI (Codex) ---
GPT_API_KEY=
GPT_BASE_URL=https://api.openai.com/v1
CODEX_BIN=

# --- DeepSeek (dsh) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DSH_BIN=

# --- shared ---
NATIVE_TIMEOUT_S=240
